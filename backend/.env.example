# Copy this file to .env and fill in your own values.
# Never commit the real .env - it is in .gitignore.

MONGO_URI=
# Optional: public DNS servers avoid querySrv ETIMEOUT/ECONNREFUSED errors on
# networks whose default DNS resolver cannot resolve MongoDB Atlas SRV records.
DNS_SERVERS=
# Port 5000 is taken by AirPlay Receiver on macOS (it answers with a 403),
# so MediQ falls back to 5001 locally. Render supplies PORT automatically.
PORT=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional separate secret for admin sessions. Falls back to JWT_SECRET when blank.
ADMIN_JWT_SECRET=

# Vercel frontend origin, without a trailing slash.
FRONTEND_URL=

# Admin account created by `npm run seed:admin` from the repository root.
# Use a private password of at least 12 characters and never commit backend/.env.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
