# Copy this file to .env and fill in your own values.
# Never commit the real .env - it is in .gitignore.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediq?retryWrites=true&w=majority
# Port 5000 is taken by AirPlay Receiver on macOS (it answers with a 403),
# so MediQ uses 5001. Change it here and in frontend/.env.local together.
PORT=5001

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
