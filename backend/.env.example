# Copy this file to .env and fill in your own values.
# Never commit the real .env - it is in .gitignore.

MONGO_URI=mongodb+srv://jaliyathegreat_db_user:<password>@cluster0.4k3iufa.mongodb.net/mediq?retryWrites=true&w=majority&appName=Cluster0
# Optional: public DNS servers avoid querySrv ETIMEOUT/ECONNREFUSED errors on
# networks whose default DNS resolver cannot resolve MongoDB Atlas SRV records.
DNS_SERVERS=8.8.8.8,1.1.1.1
# Port 5000 is taken by AirPlay Receiver on macOS (it answers with a 403),
# so MediQ uses 5001. Change it here and in frontend/.env.local together.
PORT=5001

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Admin account created by `npm run seed:admin` from the repository root.
# Use a private password of at least 12 characters and never commit backend/.env.
ADMIN_NAME=MediQ Admin
ADMIN_EMAIL=admin@mediq.demo
ADMIN_PASSWORD=replace_with_a_private_password
