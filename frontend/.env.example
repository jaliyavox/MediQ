# Copy to .env.local. Vite only exposes vars that start with VITE_.
#
# Local development works without this value (it falls back to the local API).
# For a deployed build it is REQUIRED and must include the /api suffix, because
# client.js appends /providers, /auth/login and so on to it:
#   VITE_API_URL=https://mediq-api-ytkg.onrender.com/api
#
# Vite inlines this at BUILD time, so changing it needs a rebuild, not a restart.
VITE_API_URL=
